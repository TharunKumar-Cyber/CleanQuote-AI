# Gemini AI extraction (server-side only)
GEMINI_API_KEY=your_gemini_api_key

# Supabase project URL and publishable key.
# The publishable key is safe for browser use; never put a service-role/secret key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# The same URL/key are read by the Express server to verify access tokens via Supabase Auth.
# You may keep the VITE_ variables above as the single source of truth.
PORT=3000
